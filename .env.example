DIFFHIVE_HOST=127.0.0.1
DIFFHIVE_PORT=8080
DIFFHIVE_DB_PATH=diffhive.db
DIFFHIVE_MAX_DIFF_BYTES=1048576
DIFFHIVE_MAX_STEPS=8
DIFFHIVE_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
DIFFHIVE_AUTH_REQUIRED=false
DIFFHIVE_AUTH_SECRET=
DIFFHIVE_BOOTSTRAP_ADMIN_USERNAME=
DIFFHIVE_BOOTSTRAP_ADMIN_PASSWORD=
DIFFHIVE_DEFAULT_TENANT_ID=default
DIFFHIVE_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
DIFFHIVE_LLM_PROVIDER=local

DIFFHIVE_ENABLED_AGENTS=lead,security,correctness-reliability,critic
DIFFHIVE_AGENT_TOKEN_BUDGET=8000
DIFFHIVE_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
DIFFHIVE_AGENT_CONTEXT_WINDOW_TOKENS=32768
DIFFHIVE_AGENT_CONTEXT_INPUT_TOKENS=20000
DIFFHIVE_CONTEXT_DIFF_TOKEN_BUDGET=12000
DIFFHIVE_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
DIFFHIVE_CONTEXT_RECENT_OBSERVATIONS=2
DIFFHIVE_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
DIFFHIVE_LLM_INPUT_COST_PER_MILLION=0
DIFFHIVE_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
DIFFHIVE_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
DIFFHIVE_OPENROUTER_API_KEY=
DIFFHIVE_OPENROUTER_SITE_URL=
DIFFHIVE_OPENROUTER_APP_NAME=DiffHive

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
DIFFHIVE_LLM_BASE_URL=
DIFFHIVE_LLM_API_KEY=
DIFFHIVE_LLM_MODEL=

# Replay evaluation and evolution activation gate
DIFFHIVE_EVAL_MAX_CASES=5
DIFFHIVE_EVAL_MIN_CASES=3
DIFFHIVE_EVAL_MIN_HOLDOUT_CASES=2
DIFFHIVE_EVAL_MIN_IMPROVEMENT=0.01
DIFFHIVE_EVAL_MAX_METRIC_REGRESSION=0
DIFFHIVE_EVALUATION_MIN_PUBLIC_PRS=300
DIFFHIVE_EVALUATION_MIN_F1_IMPROVEMENT=0.03
DIFFHIVE_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
DIFFHIVE_GITHUB_WEBHOOK_SECRET=
DIFFHIVE_GITHUB_TOKEN=
DIFFHIVE_AUTO_POST_REVIEW=false
DIFFHIVE_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
DIFFHIVE_DATABASE_URL=
DIFFHIVE_REDIS_URL=
DIFFHIVE_ASYNC_WORKERS=2
DIFFHIVE_QUEUE_MAX_ATTEMPTS=3
DIFFHIVE_QUEUE_LEASE_SECONDS=60
DIFFHIVE_SKILLS_DIR=skills

# Repair verification and observability
DIFFHIVE_REPAIR_TEST_COMMAND=
DIFFHIVE_REPAIR_VERIFY_TIMEOUT_SECONDS=120
DIFFHIVE_MEMORY_ENABLED=true
DIFFHIVE_MEMORY_RECALL_LIMIT=6
DIFFHIVE_MEMORY_WORKING_TTL_SECONDS=86400
DIFFHIVE_OTEL_ENDPOINT=
DIFFHIVE_OTEL_SERVICE_NAME=diffhive
DIFFHIVE_ALERT_FAILURE_RATE=0.20
DIFFHIVE_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
DIFFHIVE_GITHUB_APP_ID=
DIFFHIVE_GITHUB_APP_SLUG=
DIFFHIVE_GITHUB_PRIVATE_KEY_PATH=
DIFFHIVE_PUBLIC_BASE_URL=http://127.0.0.1:8080
